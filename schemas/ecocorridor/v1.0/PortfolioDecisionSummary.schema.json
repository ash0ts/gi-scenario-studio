{
  "$defs": {
    "PortfolioDisposition": {
      "enum": [
        "PASSES",
        "FAILS",
        "INCOMPLETE",
        "SURVEY_FIRST"
      ],
      "title": "PortfolioDisposition",
      "type": "string"
    },
    "RuleDisposition": {
      "additionalProperties": false,
      "properties": {
        "evidence_claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Claim Id"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Value"
        },
        "pair_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Id"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        }
      },
      "required": [
        "rule_id",
        "passed",
        "explanation"
      ],
      "title": "RuleDisposition",
      "type": "object"
    }
  },
  "$id": "https://schemas.ecocorridor.local/1.0/PortfolioDecisionSummary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "controlling_pair_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Controlling Pair Id"
    },
    "controlling_scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Controlling Scenario Id"
    },
    "cost": {
      "minimum": 0,
      "title": "Cost",
      "type": "number"
    },
    "currency": {
      "title": "Currency",
      "type": "string"
    },
    "direct_run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Direct Run Ids",
      "type": "array"
    },
    "disposition": {
      "$ref": "#/$defs/PortfolioDisposition"
    },
    "disposition_evidence_claim_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disposition Evidence Claim Id"
    },
    "next_action": {
      "title": "Next Action",
      "type": "string"
    },
    "portfolio_id": {
      "title": "Portfolio Id",
      "type": "string"
    },
    "review_mask_triggered": {
      "default": false,
      "title": "Review Mask Triggered",
      "type": "boolean"
    },
    "rule_dispositions": {
      "items": {
        "$ref": "#/$defs/RuleDisposition"
      },
      "title": "Rule Dispositions",
      "type": "array"
    },
    "safeguard_passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Safeguard Passed"
    },
    "unresolved_feasibility": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Feasibility",
      "type": "array"
    },
    "worst_resistance_reduction_percent": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worst Resistance Reduction Percent"
    }
  },
  "required": [
    "portfolio_id",
    "disposition",
    "cost",
    "currency",
    "rule_dispositions",
    "next_action"
  ],
  "title": "PortfolioDecisionSummary",
  "type": "object"
}

{
  "$id": "https://schemas.ecocorridor.local/1.0/SafeguardRecord.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "concerns": {
      "items": {
        "type": "string"
      },
      "title": "Concerns",
      "type": "array"
    },
    "guild_id": {
      "title": "Guild Id",
      "type": "string"
    },
    "nonregression_threshold_percent": {
      "minimum": 0,
      "title": "Nonregression Threshold Percent",
      "type": "number"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewed_by": {
      "title": "Reviewed By",
      "type": "string"
    },
    "safeguard_id": {
      "title": "Safeguard Id",
      "type": "string"
    },
    "scenario_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Scenario Ids",
      "type": "array"
    }
  },
  "required": [
    "safeguard_id",
    "guild_id",
    "scenario_ids",
    "nonregression_threshold_percent",
    "reviewed_by",
    "reviewed_at"
  ],
  "title": "SafeguardRecord",
  "type": "object"
}

{
  "$id": "https://schemas.ecocorridor.local/1.0/ModelRevision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "diff_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diff Id"
    },
    "model_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Sha256",
      "type": "string"
    },
    "parent_revision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Revision Id"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "revision_id": {
      "title": "Revision Id",
      "type": "string"
    }
  },
  "required": [
    "revision_id",
    "project_id",
    "created_at",
    "created_by",
    "reason",
    "model_sha256"
  ],
  "title": "ModelRevision",
  "type": "object"
}

    "future_condition": {
      "title": "Future Condition",
      "type": "string"
    },
    "grid_id": {
      "title": "Grid Id",
      "type": "string"
    },
    "guild_id": {
      "title": "Guild Id",
      "type": "string"
    },
    "hypothesis_id": {
      "title": "Hypothesis Id",
      "type": "string"
    },
    "life_stage": {
      "title": "Life Stage",
      "type": "string"
    },
    "maturity_horizon": {
      "title": "Maturity Horizon",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "resistance_asset_id": {
      "title": "Resistance Asset Id",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewed_by": {
      "title": "Reviewed By",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }

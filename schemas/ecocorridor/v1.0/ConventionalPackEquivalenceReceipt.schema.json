{
  "$id": "https://schemas.ecocorridor.local/1.0/ConventionalPackEquivalenceReceipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hash-bound proof that every scientific component is shared across arms.",
  "properties": {
    "case_component_sha256s": {
      "additionalProperties": {
        "additionalProperties": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "type": "object"
      },
      "minProperties": 1,
      "title": "Case Component Sha256S",
      "type": "object"
    },
    "conventional_pack_manifest_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Conventional Pack Manifest Sha256",
      "type": "string"
    },
    "ecocorridor_evidence_manifest_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ecocorridor Evidence Manifest Sha256",
      "type": "string"
    },
    "exact_component_equivalence": {
      "const": true,
      "default": true,
      "title": "Exact Component Equivalence",
      "type": "boolean"
    },
    "independent_verifier_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Independent Verifier Sha256",
      "type": "string"
    },
    "protocol_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Sha256",
      "type": "string"
    },
    "receipt_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receipt Sha256"
    },
    "schema_version": {
      "const": "ecocorridor-conventional-pack-equivalence/v1",
      "default": "ecocorridor-conventional-pack-equivalence/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Source Commit",
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "title": "Verified At",
      "type": "string"
    }
  },
  "required": [
    "protocol_sha256",
    "source_commit",
    "case_component_sha256s",
    "conventional_pack_manifest_sha256",
    "ecocorridor_evidence_manifest_sha256",
    "independent_verifier_sha256",
    "verified_at"
  ],
  "title": "ConventionalPackEquivalenceReceipt",
  "type": "object"
}

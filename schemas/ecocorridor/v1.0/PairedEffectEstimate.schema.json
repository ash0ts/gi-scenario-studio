{
  "$defs": {
    "EffectConclusion": {
      "enum": [
        "IMPROVED",
        "NONINFERIOR",
        "WORSE",
        "INCONCLUSIVE"
      ],
      "title": "EffectConclusion",
      "type": "string"
    },
    "EffectDirection": {
      "enum": [
        "LOWER_IS_BETTER",
        "HIGHER_IS_BETTER"
      ],
      "title": "EffectDirection",
      "type": "string"
    }
  },
  "$id": "https://schemas.ecocorridor.local/1.0/PairedEffectEstimate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bootstrap_resamples": {
      "minimum": 100,
      "title": "Bootstrap Resamples",
      "type": "integer"
    },
    "bootstrap_seed": {
      "title": "Bootstrap Seed",
      "type": "integer"
    },
    "comparison_arm_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Comparison Arm Id",
      "type": "string"
    },
    "conclusion": {
      "$ref": "#/$defs/EffectConclusion"
    },
    "confidence_interval_high": {
      "title": "Confidence Interval High",
      "type": "number"
    },
    "confidence_interval_low": {
      "title": "Confidence Interval Low",
      "type": "number"
    },
    "confidence_level": {
      "default": 0.95,
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0.5,
      "title": "Confidence Level",
      "type": "number"
    },
    "direction": {
      "$ref": "#/$defs/EffectDirection"
    },
    "effect_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Effect Id",
      "type": "string"
    },
    "estimand": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Estimand",
      "type": "string"
    },
    "estimate": {
      "title": "Estimate",
      "type": "number"
    },
    "noninferiority_margin": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Noninferiority Margin"
    },
    "outcome_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Outcome Id",
      "type": "string"
    },
    "pair_count": {
      "minimum": 2,
      "title": "Pair Count",
      "type": "integer"
    },
    "reference_arm_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Reference Arm Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ecocorridor-usefulness-study/v1.0",
      "default": "ecocorridor-usefulness-study/v1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unit": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "effect_id",
    "outcome_id",
    "reference_arm_id",
    "comparison_arm_id",
    "estimand",
    "unit",
    "direction",
    "pair_count",
    "estimate",
    "confidence_interval_low",
    "confidence_interval_high",
    "bootstrap_seed",
    "bootstrap_resamples",
    "conclusion"
  ],
  "title": "PairedEffectEstimate",
  "type": "object"
}

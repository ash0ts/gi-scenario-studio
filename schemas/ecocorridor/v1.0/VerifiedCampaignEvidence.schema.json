        "unsafe_draft_count": {
          "minimum": 0,
          "title": "Unsafe Draft Count",
          "type": "integer"
        },
        "unsupported_finding_count": {
          "minimum": 0,
          "title": "Unsupported Finding Count",
          "type": "integer"
        }
      },
      "required": [
        "direct_landscape_sha256s",
        "critical_required_finding_recall",
        "evidence_precision",
        "unsupported_finding_count",
        "prohibited_claim_count",
        "unsafe_draft_count",
        "adjudicated_truth_index_sha256"
      ],
      "title": "SyntheticTaskCampaignSummary",
      "type": "object"
    },
    "TraceIntegrityCampaignSummary": {
      "additionalProperties": false,
      "properties": {
        "campaign_kind": {
          "const": "TRACE_INTEGRITY",
          "default": "TRACE_INTEGRITY",
          "title": "Campaign Kind",
          "type": "string"
        },
        "exact_trace_readback_count": {
          "minimum": 0,
          "title": "Exact Trace Readback Count",
          "type": "integer"
        },
        "provider_invocations": {
          "exclusiveMinimum": 0,
          "title": "Provider Invocations",
          "type": "integer"
        },
        "released_without_trace_count": {
          "minimum": 0,
          "title": "Released Without Trace Count",
          "type": "integer"
        },
        "summary_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary Sha256"
        },
        "trace_index_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trace Index Sha256",
          "type": "string"
        }
      },
      "required": [
        "provider_invocations",
        "exact_trace_readback_count",
        "released_without_trace_count",
        "trace_index_sha256"
      ],
      "title": "TraceIntegrityCampaignSummary",
      "type": "object"
    }
  },
  "$id": "https://schemas.ecocorridor.local/1.0/VerifiedCampaignEvidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_receipt": {
      "$ref": "#/$defs/CampaignArtifactReceipt"
    },
    "raw_artifact_json": {
      "minLength": 2,
      "title": "Raw Artifact Json",
      "type": "string"
    },
    "summary": {
      "discriminator": {
        "mapping": {
          "AGENT_COMPLEXITY": "#/$defs/AgentComplexityCampaignSummary",
          "PARTNER_SHADOW": "#/$defs/PartnerShadowCampaignSummary",
          "PRACTITIONER_CONFIRMATORY": "#/$defs/PractitionerConfirmatoryCampaignSummary",
          "SAFETY_CAMPAIGN": "#/$defs/SafetyCampaignClaimSummary",
          "SYNTHETIC_TASK": "#/$defs/SyntheticTaskCampaignSummary",
          "TRACE_INTEGRITY": "#/$defs/TraceIntegrityCampaignSummary"
        },
        "propertyName": "campaign_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TraceIntegrityCampaignSummary"
        },
        {
          "$ref": "#/$defs/SyntheticTaskCampaignSummary"
        },
        {
          "$ref": "#/$defs/AgentComplexityCampaignSummary"
        },
        {
          "$ref": "#/$defs/SafetyCampaignClaimSummary"
        },
        {
          "$ref": "#/$defs/PractitionerConfirmatoryCampaignSummary"
        },
        {
          "$ref": "#/$defs/PartnerShadowCampaignSummary"
        }
      ],
      "title": "Summary"
    }
  },
  "required": [
    "raw_artifact_json",
    "summary",
    "artifact_receipt"
  ],
  "title": "VerifiedCampaignEvidence",
  "type": "object"
}

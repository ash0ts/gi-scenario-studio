          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "label",
        "source_id"
      ],
      "title": "AssistantEvidenceReference",
      "type": "object"
    },
    "AssistantNumericClaim": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "exact": {
          "const": true,
          "default": true,
          "title": "Exact",
          "type": "boolean"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "object_id": {
          "default": "",
          "title": "Object Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "units": {
          "title": "Units",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value",
        "units",
        "evidence_id",
        "run_id",
        "metric_id"
      ],

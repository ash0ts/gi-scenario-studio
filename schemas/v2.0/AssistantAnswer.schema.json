          "type": "string"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "external_project": {
          "title": "External Project",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "provider_call_id": {
          "title": "Provider Call Id",
          "type": "string"
        },
        "reference_id": {
          "title": "Reference Id",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"

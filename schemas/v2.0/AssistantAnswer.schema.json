      "items": {
        "$ref": "#/$defs/AssistantNumericClaim"
      },
      "title": "Numeric Claims",
      "type": "array"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "proposed_actions": {
      "items": {
        "$ref": "#/$defs/AssistantProposedAction"
      },
      "title": "Proposed Actions",
      "type": "array"
    },

{
  "$defs": {
    "AssistantEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "project",
            "model_fitness",
            "alternative",
            "exact_run",
            "exact_metric",
            "derived_metric",
            "decision_rule",
            "cost_basis",
            "qa",
            "limitation",
            "artifact",
            "documentation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "label",
        "source_id"
      ],
      "title": "AssistantEvidenceReference",
      "type": "object"
    },
    "AssistantNumericClaim": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/EvidenceAuthority",
          "default": "exact_swmm"
        },
        "derivation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derivation"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "exact": {
          "default": true,
          "title": "Exact",
          "type": "boolean"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "object_id": {
          "default": "",
          "title": "Object Id",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "units": {
          "title": "Units",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value",
        "units",
        "evidence_id"
      ],
      "title": "AssistantNumericClaim",
      "type": "object"
    },
    "AssistantProposedAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "navigate",
            "open_evidence",
            "review",
            "prepare_draft"
          ],
          "title": "Action",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "object_ids": {
          "items": {
            "type": "string"
          },
          "title": "Object Ids",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "AssistantProposedAction",
      "type": "object"
    },
    "EvidenceAuthority": {
      "description": "Authority carried by a claim without implying that every value is hydraulic truth.",
      "enum": [
        "exact_swmm",
        "derived_exact",
        "sourced_input",
        "decision_rule",
        "qa_record",
        "model_fitness",
        "project_record",
        "documentation"
      ],
      "title": "EvidenceAuthority",
      "type": "string"
    },
    "WeaveConversationReference": {
      "additionalProperties": false,
      "description": "Acknowledged Weave Agents turn associated with one local assistant turn.",
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "agent_version": {
          "title": "Agent Version",
          "type": "string"
        },
        "conversation_id": {
          "title": "Conversation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "external_project": {
          "title": "External Project",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "reference_id": {
          "title": "Reference Id",
          "type": "string"
        },
        "root_span_id": {
          "title": "Root Span Id",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "conversation_id",
        "turn_id",
        "entity",
        "external_project",
        "trace_id",
        "root_span_id",
        "url",
        "agent_id",
        "agent_version"
      ],
      "title": "WeaveConversationReference",
      "type": "object"
    },
    "WeaveTraceReference": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "external_project": {
          "title": "External Project",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "provider_call_id": {
          "title": "Provider Call Id",
          "type": "string"
        },
        "reference_id": {
          "title": "Reference Id",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "call_id",
        "entity",
        "external_project",
        "trace_id",
        "provider_call_id",
        "url"
      ],
      "title": "WeaveTraceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_variant_id": {
      "default": "A0",
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4"
      ],
      "title": "Agent Variant Id",
      "type": "string"
    },
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "answer_id": {
      "title": "Answer Id",
      "type": "string"
    },
    "assumptions_used": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions Used",
      "type": "array"
    },
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "conversation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_packet_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Packet Id"
    },
    "evidence_packet_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Packet Sha256"
    },
    "evidence_references": {
      "items": {
        "$ref": "#/$defs/AssistantEvidenceReference"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "evidence_tool_calls": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Tool Calls",
      "type": "array"
    },
    "explanation_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Explanation Plan Id"
    },
    "intent": {
      "title": "Intent",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "numeric_claims": {
      "items": {
        "$ref": "#/$defs/AssistantNumericClaim"
      },
      "title": "Numeric Claims",
      "type": "array"
    },
    "practitioner_usefulness_status": {
      "const": "not_measured",
      "default": "not_measured",
      "title": "Practitioner Usefulness Status",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "proposed_actions": {
      "items": {
        "$ref": "#/$defs/AssistantProposedAction"
      },
      "title": "Proposed Actions",
      "type": "array"
    },
    "provider_call_count": {
      "anyOf": [
        {
          "maximum": 2,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Call Count"
    },
    "provider_call_ids": {
      "items": {
        "type": "string"
      },
      "title": "Provider Call Ids",
      "type": "array"
    },
    "provider_input_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Provider Input Tokens",
      "type": "integer"
    },
    "provider_latency_ms": {
      "default": 0.0,
      "minimum": 0,
      "title": "Provider Latency Ms",
      "type": "number"
    },
    "provider_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Model Id"
    },
    "provider_output_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Provider Output Tokens",
      "type": "integer"
    },
    "provider_total_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Provider Total Tokens",
      "type": "integer"
    },
    "provider_transport_attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Provider Transport Attempts",
      "type": "integer"
    },
    "read_only": {
      "const": true,
      "default": true,
      "title": "Read Only",
      "type": "boolean"
    },
    "release_basis": {
      "const": "automated_conformance",
      "default": "automated_conformance",
      "title": "Release Basis",
      "type": "string"
    },
    "release_gate_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Gate Digest"
    },
    "requires_engineer_confirmation": {
      "const": true,
      "default": true,
      "title": "Requires Engineer Confirmation",
      "type": "boolean"
    },
    "response_schema_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Schema Sha256"
    },
    "response_schema_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Schema Version"
    },
    "tool_contract_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Contract Version"
    },
    "turn_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    },
    "validator_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validator Version"
    },
    "weave_conversation": {
      "anyOf": [
        {
          "$ref": "#/$defs/WeaveConversationReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "weave_trace": {
      "anyOf": [
        {
          "$ref": "#/$defs/WeaveTraceReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "call_id",
    "project_id",
    "intent",
    "answer"
  ],
  "title": "AssistantAnswer",
  "type": "object"
}

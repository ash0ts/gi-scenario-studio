      "const": true,
      "default": true,
      "title": "Read Only",
      "type": "boolean"
    },
    "requires_engineer_confirmation": {
      "const": true,
      "default": true,
      "title": "Requires Engineer Confirmation",
      "type": "boolean"
    },
    "weave_trace": {

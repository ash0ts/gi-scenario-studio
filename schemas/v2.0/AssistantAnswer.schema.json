      "title": "Answer",
      "type": "string"
    },
    "answer_id": {
      "title": "Answer Id",
      "type": "string"
    },
    "assumptions_used": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions Used",
      "type": "array"
    },
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },

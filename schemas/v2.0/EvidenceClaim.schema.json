{
  "$defs": {
    "EvidenceAuthority": {
      "description": "Authority carried by a claim without implying that every value is hydraulic truth.",
      "enum": [
        "exact_swmm",
        "derived_exact",
        "sourced_input",
        "decision_rule",
        "qa_record",
        "model_fitness",
        "project_record",
        "documentation"
      ],
      "title": "EvidenceAuthority",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority": {
      "$ref": "#/$defs/EvidenceAuthority",
      "default": "project_record"
    },
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "claim_type": {
      "enum": [
        "exact_metric",
        "qa",
        "assumption",
        "cost",
        "provenance",
        "fitness",
        "reference_comparison",
        "derived_metric",
        "decision_rule",
        "limitation"
      ],
      "title": "Claim Type",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "derivation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Derivation"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "exact": {
      "default": false,
      "title": "Exact",
      "type": "boolean"
    },
    "metric_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metric Id"
    },
    "object_id": {
      "default": "",
      "title": "Object Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Run Ids",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    },
    "units": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Units"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "project_id",
    "claim_type",
    "statement",
    "evidence_ids"
  ],
  "title": "EvidenceClaim",
  "type": "object"
}

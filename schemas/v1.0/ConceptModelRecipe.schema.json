{
  "$defs": {
    "DataAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "crs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crs"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "vintage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vintage"
        }
      },
      "required": [
        "path",
        "role",
        "source",
        "license"
      ],
      "title": "DataAsset",
      "type": "object"
    },
    "OutletSpec": {
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "invert_elevation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invert Elevation"
        },
        "outlet_id": {
          "title": "Outlet Id",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "outlet_id",
        "x",
        "y"
      ],
      "title": "OutletSpec",
      "type": "object"
    },
    "StudyArea": {
      "additionalProperties": false,
      "properties": {
        "boundary": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 4,
          "title": "Boundary",
          "type": "array"
        },
        "crs": {
          "title": "Crs",
          "type": "string"
        },
        "name": {
          "default": "Study area",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "boundary",
        "crs"
      ],
      "title": "StudyArea",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "additionalProperties": true,
      "title": "Assumptions",
      "type": "object"
    },
    "coordinate_units": {
      "default": "meters",
      "enum": [
        "feet",
        "meters"
      ],
      "title": "Coordinate Units",
      "type": "string"
    },
    "data_assets": {
      "items": {
        "$ref": "#/$defs/DataAsset"
      },
      "title": "Data Assets",
      "type": "array"
    },
    "flow_units": {
      "default": "CMS",
      "enum": [
        "CFS",
        "CMS",
        "LPS"
      ],
      "title": "Flow Units",
      "type": "string"
    },
    "outlets": {
      "items": {
        "$ref": "#/$defs/OutletSpec"
      },
      "minItems": 1,
      "title": "Outlets",
      "type": "array"
    },
    "recipe_id": {
      "title": "Recipe Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "default": 42,
      "title": "Seed",
      "type": "integer"
    },
    "study_area": {
      "$ref": "#/$defs/StudyArea"
    },
    "subcatchment_count": {
      "default": 4,
      "maximum": 64,
      "minimum": 1,
      "title": "Subcatchment Count",
      "type": "integer"
    },
    "synthesis_engine": {
      "default": "local_deterministic",
      "enum": [
        "local_deterministic",
        "swmmanywhere"
      ],
      "title": "Synthesis Engine",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "study_area",
    "outlets"
  ],
  "title": "ConceptModelRecipe",
  "type": "object"
}

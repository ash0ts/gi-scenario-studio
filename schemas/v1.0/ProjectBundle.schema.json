{
  "$defs": {
    "AuthorityStatus": {
      "enum": [
        "adopted",
        "preliminary",
        "sensitivity",
        "user_defined"
      ],
      "title": "AuthorityStatus",
      "type": "string"
    },
    "DataAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "crs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crs"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "vintage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vintage"
        }
      },
      "required": [
        "path",
        "role",
        "source",
        "license"
      ],
      "title": "DataAsset",
      "type": "object"
    },
    "ModelReadiness": {
      "additionalProperties": false,
      "properties": {
        "attestations": {
          "items": {
            "$ref": "#/$defs/ReadinessAttestation"
          },
          "title": "Attestations",
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/ReadinessLevel"
        },
        "reference_comparison_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Comparison Id"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "unresolved_limitations": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Limitations",
          "type": "array"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "level"
      ],
      "title": "ModelReadiness",
      "type": "object"
    },
    "ReadinessAttestation": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "default": false,
          "title": "Accepted",
          "type": "boolean"
        },
        "accepted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted At"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "ReadinessAttestation",
      "type": "object"
    },
    "ReadinessLevel": {
      "enum": [
        "DEMO",
        "CONCEPTUAL",
        "ENGINEER_REVIEWED",
        "REFERENCE_MATCHED"
      ],
      "title": "ReadinessLevel",
      "type": "string"
    },
    "StormCase": {
      "additionalProperties": false,
      "properties": {
        "aep": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aep"
        },
        "authority_status": {
          "$ref": "#/$defs/AuthorityStatus"
        },
        "boundary_assumptions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary Assumptions"
        },
        "duration_hours": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Hours"
        },
        "initial_conditions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Conditions"
        },
        "model_path": {
          "title": "Model Path",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "storm_id": {
          "title": "Storm Id",
          "type": "string"
        }
      },
      "required": [
        "name",
        "model_path",
        "role",
        "authority_status",
        "source"
      ],
      "title": "StormCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_model_path": {
      "title": "Base Model Path",
      "type": "string"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/DataAsset"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "readiness": {
      "$ref": "#/$defs/ModelReadiness"
    },
    "reference_report_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Report Path"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "storm_cases": {
      "items": {
        "$ref": "#/$defs/StormCase"
      },
      "title": "Storm Cases",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "base_model_path",
    "readiness"
  ],
  "title": "ProjectBundle",
  "type": "object"
}

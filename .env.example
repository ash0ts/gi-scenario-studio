# W&B Models and Weave connection. Never commit real values.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=
WANDB_REPORT_ENTITY=
WANDB_REPORT_PROJECT=
WANDB_BASE_URL=https://api.wandb.ai
WANDB_DEPLOYMENT=wandb_cloud
WANDB_MODE=online

# Defensive SDK defaults used by the worker and benchmark harness.
WANDB_CONSOLE=off
WANDB_DISABLE_CODE=true
WANDB_DISABLE_GIT=true
WANDB_ERROR_REPORTING=false
WANDB_SHOW_RUN=false

# Optional OpenAI-compatible Evidence Assistant provider.
GI_ASSISTANT_BASE_URL=
GI_ASSISTANT_API_KEY=
GI_ASSISTANT_MODEL=

{
  "name": "@ecocorridor-scenario-studio/replay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1431",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --host 127.0.0.1 --port 4431 --strictPort",
    "test:rendered-copy": "playwright test --config playwright.rendered-copy.config.ts"
  },
  "dependencies": {
    "@ecocorridor-scenario-studio/evidence": "workspace:*",
    "@scenario-platform/ui-foundations": "workspace:*",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EcoCorridor Scenario Studio",
  "version": "0.1.0",
  "identifier": "org.ecocorridor.scenariostudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "EcoCorridor Scenario Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Science",
    "shortDescription": "Auditable wildlife-connectivity portfolios",
    "longDescription": "A local-authority workbench for directly evaluated, assumption-bound Circuitscape connectivity portfolios."
  }
}
